# ---- required ---------------------------------------------------------------
# Railway does NOT set this for you. Create the Postgres service first, then on
# the app service set DATABASE_URL to the reference ${{Postgres.DATABASE_URL}}
# -- it only resolves once a service with that exact name exists, and a NEW
# deploy is needed to pick it up (Restart/Redeploy reuse the old variables).
DATABASE_URL=postgresql://user:password@host:5432/railway

# Signs the session cookies AND derives the key that encrypts the LinkedIn
# tokens at rest. Generate once with:  openssl rand -hex 32
# Changing it signs everyone out and makes the stored LinkedIn tokens
# unreadable (you would have to paste them again).
APP_SECRET=change-me-to-a-long-random-string

# The first admin, created on the very first boot only.
ADMIN_EMAIL=julio@kalungi.com
ADMIN_PASSWORD=pick-a-strong-one

# ---- google sign-in (optional) ----------------------------------------------
# An OAuth client of type "Web application" in Google Cloud. Its authorized
# redirect URI must be exactly https://<your-domain>/api/auth/google/callback
# Leave both empty and the login screen only offers email and password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only verified addresses in this Workspace domain may sign in with Google,
# and they get a member account on their first sign-in without anyone
# approving it. Leaving it empty lets in ANY Google account, including
# personal gmail ones -- almost never what you want.
GOOGLE_ALLOWED_DOMAIN=kalungi.com

# Where Google sends the browser back. On Railway this is derived from
# RAILWAY_PUBLIC_DOMAIN; set it only for a custom domain. No trailing slash.
PUBLIC_BASE_URL=

# ---- optional ---------------------------------------------------------------
# Paste the whole service-account JSON on one line to enable Google Sheets.
# Leave empty and the app works with CSV uploads only.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Default time zone for new users and accounts.
DEFAULT_TIMEZONE=America/Guayaquil

# Set to false on the web service if you run the worker as its own Railway
# service (start command: python -m app.worker).
RUN_WORKER=true
WORKER_POLL_SECONDS=15

# Ceilings the app will not let any account exceed, whatever the UI asks for.
MAX_DAILY_LIMIT=80
MAX_WEEKLY_LIMIT=200

# Set to false only for local development over plain http.
COOKIE_SECURE=true

# Only needed if the frontend is served from another domain (dev proxy, etc).
CORS_ORIGINS=
